# motion-forge API — axum binary that serves /generate, /iterate, /themes,
# /openapi.json, /healthz. Stays warm (ACA min_replicas=1).
#
# Build (from repo root):
#   docker buildx build --platform linux/amd64 -t motion-forge-api:latest \
#       -f infra/docker/Dockerfile.api .

# ---- builder ----
FROM public.ecr.aws/docker/library/rust:1.96-slim-bookworm AS builder
WORKDIR /src

# Cache the dependency layer. `cmake`, `clang`, and `build-essential` are
# needed so `whisper-rs` can compile its bundled whisper.cpp from source.
# Apply all pending security updates so Trivy doesn't flag fixable
# CRITICAL/HIGH vulns from the stale base-image tag.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    pkg-config ca-certificates curl \
    cmake clang build-essential libssl-dev libstdc++-12-dev \
 && rm -rf /var/lib/apt/lists/*

COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY themes ./themes

RUN cargo build --release --bin motion-forge

# ---- runtime ----
FROM public.ecr.aws/docker/library/debian:bookworm-slim AS runtime
WORKDIR /app

# Only the ffmpeg binary — no libav*-dev needed; we use ffmpeg-sidecar.
# libstdc++ + libgomp are needed at runtime by the statically-bundled
# whisper.cpp (it links the system C++ runtime + OpenMP).
# Apply pending security updates before installing runtime packages so
# CVEs against base-image libs are patched.
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends \
    ca-certificates ffmpeg tini libgomp1 libstdc++6 \
 && rm -rf /var/lib/apt/lists/*

# Non-root user
RUN useradd --create-home --uid 10001 motionforge

COPY --from=builder /src/target/release/motion-forge /usr/local/bin/motion-forge
COPY --chown=motionforge:motionforge themes /app/themes

# Mount the whisper GGUF model at this path (read-only volume) and the
# server will auto-enable /v1/stt/stream. Run scripts/fetch-whisper-model.sh
# in the build host or download in an init container.
ENV MOTION_FORGE_THEMES_DIR=/app/themes \
    RUST_LOG=info,motion_forge=info \
    MOTION_FORGE_LLM_TIMEOUT_SEC=30 \
    MOTION_FORGE_STT_MODEL_PATH=/app/models/ggml-large-v3-turbo-q5_0.bin

USER motionforge
EXPOSE 7755
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/motion-forge"]
CMD ["serve", "--bind", "0.0.0.0:7755"]
