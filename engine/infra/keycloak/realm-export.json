{
  "realm": "controlcraft",
  "enabled": true,
  "displayName": "ControlCraft",
  "displayNameHtml": "<strong>ControlCraft</strong>",
  "registrationAllowed": false,
  "rememberMe": true,
  "verifyEmail": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "waitIncrementSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "failureFactor": 30,
  "accessTokenLifespan": 900,
  "accessTokenLifespanForImplicitFlow": 900,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "offlineSessionIdleTimeout": 2592000,
  "accessCodeLifespan": 60,
  "accessCodeLifespanUserAction": 300,
  "accessCodeLifespanLogin": 1800,
  "actionTokenGeneratedByAdminLifespan": 43200,
  "actionTokenGeneratedByUserLifespan": 300,
  "sslRequired": "external",
  "defaultSignatureAlgorithm": "RS256",
  "revokeRefreshToken": false,
  "refreshTokenMaxReuse": 0,
  "roles": {
    "realm": [
      {
        "name": "owner",
        "description": "Full control of motion-forge tenant — billing, members, all generate/iterate calls."
      },
      {
        "name": "member",
        "description": "Can run generate/iterate but cannot manage billing or members."
      },
      {
        "name": "viewer",
        "description": "Read-only access — list themes and previous runs, cannot generate."
      }
    ]
  },
  "defaultRoles": ["viewer"],
  "groups": [],
  "users": [
    {
      "username": "owner@motion-forge.io",
      "email": "owner@motion-forge.io",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Owner",
      "lastName": "Dev",
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ],
      "realmRoles": ["owner", "member", "viewer"]
    },
    {
      "username": "member@motion-forge.io",
      "email": "member@motion-forge.io",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Member",
      "lastName": "Dev",
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ],
      "realmRoles": ["member", "viewer"]
    },
    {
      "username": "viewer@motion-forge.io",
      "email": "viewer@motion-forge.io",
      "emailVerified": true,
      "enabled": true,
      "firstName": "Viewer",
      "lastName": "Dev",
      "credentials": [
        {
          "type": "password",
          "value": "dev",
          "temporary": false
        }
      ],
      "realmRoles": ["viewer"]
    }
  ],
  "clients": [
    {
      "clientId": "motion-forge-web",
      "name": "motion-forge Web (Next.js)",
      "description": "Confidential OIDC client used by the Next.js front-end. Auth Code + PKCE flow; back-channel token exchange runs server-side via NextAuth.",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "fullScopeAllowed": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "motion-forge-web-dev-secret",
      "rootUrl": "http://localhost:3001",
      "baseUrl": "http://localhost:3001",
      "redirectUris": [
        "http://localhost:3001/*",
        "https://motion.ursly.io/*"
      ],
      "webOrigins": [
        "http://localhost:3001",
        "https://motion.ursly.io"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3001/*##https://motion.ursly.io/*",
        "access.token.lifespan": "900"
      },
      "protocolMappers": [
        {
          "name": "audience-motion-forge-web",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "motion-forge-web",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        },
        {
          "name": "realm-roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "multivalued": "true",
            "user.attribute": "foo",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "claim.name": "realm_access.roles",
            "jsonType.label": "String"
          }
        }
      ]
    },
    {
      "clientId": "motion-forge-engine",
      "name": "motion-forge Engine (service account)",
      "description": "Confidential OIDC client for the engine CLI and other non-browser callers (e.g. CI, batch jobs).",
      "enabled": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "implicitFlowEnabled": false,
      "serviceAccountsEnabled": true,
      "frontchannelLogout": false,
      "fullScopeAllowed": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "motion-forge-engine-dev-secret",
      "attributes": {
        "access.token.lifespan": "900",
        "use.refresh.tokens": "false"
      },
      "protocolMappers": [
        {
          "name": "audience-motion-forge-engine",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "motion-forge-engine",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "browserSecurityHeaders": {
    "contentSecurityPolicy": "frame-src 'self'; frame-ancestors 'self'; object-src 'none';",
    "xContentTypeOptions": "nosniff",
    "xFrameOptions": "SAMEORIGIN",
    "xRobotsTag": "none",
    "xXSSProtection": "1; mode=block",
    "strictTransportSecurity": "max-age=31536000; includeSubDomains"
  },
  "smtpServer": {},
  "eventsEnabled": false,
  "adminEventsEnabled": false
}
