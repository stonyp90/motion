{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "IMTN",
  "version": "0.1.0",
  "identifier": "io.imtn.desktop",
  "build": {
    "frontendDist": "http://localhost:3010",
    "devUrl": "http://localhost:3010"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Motion graphics from a prompt — local engine + local models",
    "longDescription": "IMTN runs the motion-forge prompt-to-Lottie pipeline on your machine with bundled engine and Ollama sidecars. No cloud round-trip required.",
    "copyright": "Copyright (c) 2026 IMTN",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "wix": {
        "language": ["en-US"]
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
