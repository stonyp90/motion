{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "ControlCraft",
  "version": "0.1.0",
  "identifier": "io.controlcraft.desktop",
  "build": {
    "frontendDist": "https://controlcraft.io",
    "devUrl": "http://localhost:3010"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://controlcraft.io/api/updater/{{target}}-{{arch}}/{{current_version}}"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEYzNDMwRTJFOEEzQTA4RTkKUldUcENEcUtMZzVEOHdhVFBBcDJhWFlzYTlEY0wzQUlNZlJHclpMOVZKVWsxQlUxelFmZzJtNTYK",
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Motion graphics from a prompt — local engine + local models",
    "longDescription": "ControlCraft runs the motion-forge prompt-to-Lottie pipeline on your machine with bundled engine and Ollama sidecars. No cloud round-trip required.",
    "copyright": "Copyright (c) 2026 ControlCraft",
    "externalBin": [
      "binaries/motion-forge",
      "binaries/ollama",
      "binaries/ffmpeg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "entitlements": "entitlements.plist",
      "hardenedRuntime": true
    },
    "windows": {
      "wix": {
        "language": ["en-US"]
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
