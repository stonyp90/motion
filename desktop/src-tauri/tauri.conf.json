{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "motion-forge",
  "version": "0.1.0",
  "identifier": "io.motion-forge.desktop",
  "build": {
    "frontendDist": "http://localhost:3010",
    "devUrl": "http://localhost:3010"
  },
  "app": {
    "windows": [
      {
        "title": "motion-forge",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Generate motion graphics from a prompt",
    "longDescription": "motion-forge runs your prompt-to-Lottie pipeline locally with bundled engine and Ollama sidecars. No cloud round-trip required.",
    "copyright": "Copyright (c) 2026 motion-forge",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "wix": {
        "language": ["en-US"]
      }
    },
    "linux": {
      "deb": {
        "depends": []
      }
    }
  }
}
