# Tauri 2 desktop shell — ignored artifacts.
#
# JS dependencies are restored via `npm install`; Rust build artifacts
# live under `src-tauri/target/`. Neither belongs in version control.

# JS
node_modules/

# Rust
src-tauri/target/
src-tauri/gen/
src-tauri/Cargo.lock

# Tauri-generated capability files we don't keep (autogenerated when
# you run `tauri build` for a new platform)
src-tauri/WixTools/

# Tauri signing keys — the private key MUST stay out of git. Operators
# copy the .key file's contents into the TAURI_SIGNING_PRIVATE_KEY
# GitHub Actions secret before tagging a release; the matching public
# key lives inside tauri.conf.json's `pubkey` field (safe to commit).
.tauri-keys/

# Locally-staged Ollama sidecar binaries. CI fetches its own via
# scripts/fetch-ollama.sh, but dev machines may copy a host install in
# (see desktop/DEV.md).
src-tauri/binaries/
