{
  "name": "motion-forge-website",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "predev": "node scripts/sync-themes.mjs",
    "dev": "next dev -p 3001",
    "prebuild": "node scripts/sync-themes.mjs",
    "build": "next build",
    "sync-themes": "node scripts/sync-themes.mjs",
    "start": "next start -p 3001",
    "lint": "next lint",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@auth/core": "^0.41.2",
    "@scalar/api-reference-react": "^0.9.41",
    "cmdk": "^1.1.1",
    "framer-motion": "^11.18.2",
    "lottie-react": "^2.4.1",
    "lucide-react": "^0.400.0",
    "next": "^15.5.0",
    "next-auth": "^5.0.0-beta.31",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-resizable-panels": "^4.11.2",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.56.0",
    "eslint-config-next": "^15.5.0",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0"
  },
  "overridesNote": "postcss <8.5.10 has GHSA-qx2v-qp2m-jg93 (XSS via unescaped </style> in CSS Stringify). next@15.5.18 bundles 8.4.31 transitively; the override below forces the patched version across the entire dep tree (incl. next/node_modules/postcss) so `npm audit` stays clean without waiting for Vercel to bump postcss inside the next package.",
  "overrides": {
    "postcss": "$postcss"
  }
}
