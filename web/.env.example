# ----------------------------------------------------------------------------
# motion-forge web — environment variables
# Copy to `.env.local` for local development. Vercel pulls from project env.
# ----------------------------------------------------------------------------

# Engine API base URL — what the browser (and SSR) calls.
# Local dev:    http://localhost:7755
# Production:   https://engine.motion-forge.io
NEXT_PUBLIC_ENGINE_BASE_URL=http://localhost:7755

# ----------------------------------------------------------------------------
# Keycloak / NextAuth
# Start the local Keycloak with `cd engine && docker compose up -d keycloak`.
# ----------------------------------------------------------------------------

# OIDC issuer URL — must include the realm path.
KEYCLOAK_ISSUER=http://localhost:8080/realms/motion-forge

# OIDC client ID. Defined in engine/infra/keycloak/realm-export.json.
KEYCLOAK_CLIENT_ID=motion-forge-web

# OIDC client secret. The dev value is committed to the realm export
# at engine/infra/keycloak/realm-export.json. ROTATE FOR PRODUCTION.
KEYCLOAK_CLIENT_SECRET=motion-forge-web-dev-secret

# Encryption secret for NextAuth session cookies. Generate with:
#   openssl rand -base64 32
AUTH_SECRET=replace-me-with-openssl-rand-base64-32

# Explicit base URL — only needed if NextAuth can't infer it from the
# request (e.g. when running behind a proxy with rewritten Host).
# NEXTAUTH_URL=http://localhost:3001
